generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" 
}

model Admin {
  sessionVersion Int @default(0)
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  sessionVersion Int @default(0)
  id         String   @id @default(cuid())
  employeeId String   @unique
  fullName   String
  pinHash    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model Product {
  sku String? @unique
  category String @default("Pantry")
  unit String @default("each")
  id              String         @id @default(cuid())
  name            String
  description     String?
  marketPrice     Decimal
  discountedPrice Decimal
  imagePath       String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  cycleProducts   CycleProduct[]
}

model OrderCycle {
  nextOrderNumber Int @default(1)
  id            String         @id @default(cuid())
  name          String
  startDate     DateTime?
  deadline      DateTime?
  status        String         @default("draft") // draft | open | closed
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cycleProducts CycleProduct[]
  orders        Order[]
}

model CycleProduct {
  id              String      @id @default(cuid())
  cycleId         String
  productId       String
  price           Decimal
  maxQtyPerPerson Int
  isAvailable     Boolean     @default(true)
  cycle           OrderCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  product         Product     @relation(fields: [productId], references: [id])
  orderItems      OrderItem[]

  @@unique([cycleId, productId])
}

model Order {
  id                String      @id @default(cuid())
  cycleId           String
  employeeId        String?
  employeeName      String
  orderNumber       String
  totalAmount       Decimal
  isAuthenticated   Boolean     @default(false)
  requiresSignature Boolean     @default(true)
  status            String      @default("submitted") // submitted | edited | cancelled
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  cycle             OrderCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee          Employee?   @relation(fields: [employeeId], references: [employeeId])
  items             OrderItem[]

  @@unique([cycleId, employeeId])
  @@unique([cycleId, orderNumber])
}

model OrderItem {
  id             String       @id @default(cuid())
  orderId        String
  cycleProductId String
  quantity       Int
  unitPrice      Decimal
  lineTotal      Decimal
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cycleProduct   CycleProduct @relation(fields: [cycleProductId], references: [id])
}
model LoginAttempt {
  key String @id
  attempts Int @default(0)
  resetAt DateTime
}
