# Development SQLite file; production must point to a persistent volume or hosted libSQL.
DATABASE_URL=file:./dev.db
DATABASE_AUTH_TOKEN=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
APP_TIMEZONE=Australia/Sydney

# Production admin provisioning. No password is built into the app.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_RESET_PASSWORD=false

# Enable only for a separate portfolio demonstration database.
DEMO_MODE=false
ALLOW_DEMO_SEED=false
DEMO_EMPLOYEE_ID=DEMO001
DEMO_EMPLOYEE_PASSWORD=
DEMO_ADMIN_USERNAME=demo-admin
DEMO_ADMIN_PASSWORD=

# Optional Turso Marketplace aliases (use one matching URL/token pair).
# TURSO_DATABASE_URL=libsql://your-demo-database.turso.io
# TURSO_AUTH_TOKEN=
